export component MainWindow inherits Window {
    title: "LoopMaster";
    width: 1280px;
    height: 720px;
    background: #e5e7eb;

    in-out property <[string]> source-model: [];
    in-out property <[string]> output-model: [];
    in-out property <int> source-index: -1;
    in-out property <int> output-index: -1;
    in-out property <float> gain: 0;
    in-out property <bool> running: false;
    in-out property <string> engine-state: "Stopped";
    in-out property <string> stats-text: "";
    in-out property <float> source-meter: 0;
    in-out property <float> output-meter-l: 0;
    in-out property <float> output-meter-r: 0;
    in-out property <bool> route-enabled: true;
    in-out property <bool> monitor-enabled: true;
    in-out property <bool> advanced-expanded: false;
    in-out property <bool> show-monitors: true;
    in-out property <bool> refreshing: false;
    private property <bool> route-ready: root.source-index >= 0 && root.output-index >= 0;
    private property <bool> engine-error: root.engine-state != "Running"
        && root.engine-state != "Stopped"
        && root.engine-state != "Starting";

    callback refresh();
    callback start-engine();
    callback stop-engine();
    callback apply-gain(float);
    callback source-selected(int);
    callback output-selected(int);
    callback toggle-route(bool);
    callback toggle-monitor(bool);

    Rectangle {
        width: 1280px;
        height: 720px;
        background: #e5e7eb;

        Rectangle {
            x: 0;
            y: 0;
            width: 1280px;
            height: 48px;
            background: #ffffff;
            HorizontalBox {
                x: 0;
                y: 0;
                width: 1280px;
                height: 48px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: #e8f7f4;
                    BrandMark { x: 0; y: 0; width: 26px; height: 26px; }
                }
                Text { text: "LoopMaster"; color: #1e293b; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                FooterButton {
                    width: 110px;
                    label: root.refreshing ? "刷新中..." : "刷新音源";
                    enabled: !root.refreshing;
                    clicked => { root.refresh(); }
                }
                LoopbackToggle {
                    checked <=> root.running;
                    enabled: root.route-ready;
                    label: "总引擎开关";
                    toggled(value) => { if value { root.start-engine(); } else { root.stop-engine(); } }
                }
            }
            EngineBadge {
                x: (root.width - 252px) / 2;
                y: 9px;
                active: root.running;
                label: root.running ? "音频引擎运行中 (WASAPI)" : (root.engine-error ? "音频引擎异常" : "音频引擎已停止");
            }
            Rectangle { x: 0; y: 47px; width: 1320px; height: 1px; background: #e2e8f0; }
        }

        Rectangle {
            x: 0;
            y: 48px;
            width: 250px;
            height: 672px;
            background: #f2f4f6;
            Rectangle { x: 249px; y: 0; width: 1px; height: 672px; background: #d6dbe1; }
            Text { x: 16px; y: 14px; text: "▷"; color: #64748b; font-size: 11px; }
            Text { x: 34px; y: 13px; text: "虚拟设备 (DEVICES)"; color: #64748b; font-size: 11px; font-weight: 700; }
            DemoDeviceItem { x: 10px; y: 45px; title: "Virtual Mic for Zoom"; subtitle: "Music, Farrago, USB Mic"; selected: true; active: root.running; route-enabled <=> root.route-enabled; toggled(value) => { root.toggle-route(value); } }
            DemoDeviceItem { x: 10px; y: 131px; title: "Pass-Thru (系统直通)"; subtitle: "Pass-Thru 默认通道"; selected: false; route-enabled: false; }
            DemoDeviceItem { x: 10px; y: 217px; title: "主路由 (Main Router)"; subtitle: "1 进程, 1 硬件设备"; selected: false; route-enabled: false; }
            Rectangle { x: 0; y: 624px; width: 250px; height: 1px; background: #d6dbe1; }
            Text { x: 24px; y: 640px; text: "+  新建虚拟设备"; color: #334155; font-size: 10px; font-weight: 600; }
            Text { x: 220px; y: 640px; text: "—"; color: #94a3b8; font-size: 10px; horizontal-alignment: right; }
        }

        Rectangle {
            x: 250px;
            y: 48px;
            width: 1030px;
            height: 672px;
            background: #e9ecef;
            Text { x: 32px; y: 14px; text: "Virtual Mic for Zoom"; color: #1e293b; font-size: 18px; font-weight: 700; }
            Text { x: 32px; y: 39px; text: "当前活动路由"; color: #64748b; font-size: 10px; }
            DemoWireLayer { x: 0; y: 0; connected: root.running && root.route-ready && root.route-enabled && root.monitor-enabled; show-monitor: root.show-monitors; expanded: root.advanced-expanded; }
            ColumnHeader { x: 32px; y: 58px; title: "Sources 音频来源"; subtitle: root.source-model.length + " 个应用程序"; }
            ColumnHeader { x: 382px; y: 58px; title: "Output Channels 输出通道"; subtitle: "4 通道 (2 组立体声)"; }
            if root.show-monitors: ColumnHeader { x: 732px; y: 58px; title: "Monitors 监听设备"; subtitle: "1 监听设备"; }
            DemoSourceCard {
                x: 32px;
                y: 110px;
                source-model: root.source-model;
                source-index <=> root.source-index;
                gain <=> root.gain;
                expanded <=> root.advanced-expanded;
                route-enabled <=> root.route-enabled;
                meter: root.source-meter;
                show-selector: true;
                source-selected(index) => { root.source-selected(index); }
                toggle-route(value) => { root.toggle-route(value); }
                apply-gain(value) => { root.apply-gain(value); }
            }
            if root.source-model.length > 1: DemoSourcePreview {
                x: 32px;
                y: root.advanced-expanded ? 412px : 314px;
                title: root.source-model[1];
                subtitle: "进程来源";
                meter: root.source-meter * 0.82;
                enabled: true;
                source-index: 1;
                selected(index) => { root.source-selected(index); }
            }
            DemoChannelCard { x: 382px; y: 110px; title: "Channels 1 & 2"; first-label: "Channel 1 (L)"; second-label: "Channel 2 (R)"; meter: root.source-meter; connected: root.route-ready && root.route-enabled && root.monitor-enabled; }
            DemoChannelCard { x: 382px; y: 248px; title: "Channels 3 & 4"; first-label: "Channel 3"; second-label: "Channel 4"; meter: 0; connected: false; }
            if root.show-monitors: DemoMonitorCard {
                x: 732px;
                y: 110px;
                output-model: root.output-model;
                output-index <=> root.output-index;
                meter: root.output-meter-l;
                route-enabled <=> root.monitor-enabled;
                output-selected(index) => { root.output-selected(index); }
                toggle-monitor(value) => { root.toggle-monitor(value); }
            }
            Rectangle {
                x: 0;
                y: 624px;
                width: 1030px;
                height: 48px;
                background: #ffffff;
                Rectangle { x: 0; y: 0; width: 1030px; height: 1px; background: #e2e8f0; }
                Rectangle { x: 24px; y: 20px; width: 7px; height: 7px; border-radius: 4px; background: root.running ? #29b6a2 : (root.engine-error ? #ef4444 : #94a3b8); }
                Text { x: 42px; y: 16px; text: root.engine-state == "Running" ? "音频引擎运行中" : (root.engine-state == "Stopped" ? "音频引擎已停止" : root.engine-state); color: root.running ? #1a7e70 : (root.engine-error ? #b23f3f : #64748b); font-size: 10px; font-weight: 600; }
                Rectangle { x: 120px; y: 15px; width: 1px; height: 18px; background: #e2e8f0; }
                Text { x: 132px; y: 17px; width: 560px; text: root.stats-text == "" ? "等待引擎状态" : root.stats-text; color: #64748b; font-size: 9px; overflow: elide; }
                FooterButton { x: 710px; y: 9px; label: "删除 (Delete)"; enabled: false; }
                FooterButton { x: 864px; y: 9px; label: "显示监听 (Show Monitors)"; enabled: true; active: root.show-monitors; clicked => { root.show-monitors = !root.show-monitors; } }
            }
        }
    }
}
