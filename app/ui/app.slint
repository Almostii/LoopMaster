import { VerticalBox, HorizontalBox } from "std-widgets.slint";

component BrandMark inherits Path {
    width: 30px;
    height: 30px;
    stroke: #20a894;
    stroke-width: 3px;
    fill: transparent;
    MoveTo { x: 2; y: 19; }
    LineTo { x: 15; y: 11; }
    LineTo { x: 28; y: 19; }
    MoveTo { x: 2; y: 26; }
    LineTo { x: 15; y: 18; }
    LineTo { x: 28; y: 26; }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> label: "开关";
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? #20a894 : #cbd2d8;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        x: root.checked ? parent.width - 20px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        animate x { duration: 120ms; }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    animate background { duration: 120ms; }
}

component MuteButton inherits Rectangle {
    in property <bool> muted: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 32px;
    height: 24px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.muted ? #d7a51c : #cbd5dc;
    background: root.muted
        ? (mute-touch.has-hover ? #f8d56d : #f3c64d)
        : (mute-touch.has-hover ? #e1f4f0 : #f1f5f7);
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.muted ? "取消静音" : "静音";
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: "M";
        color: root.muted ? #6b4d00 : #52606d;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    mute-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    animate background { duration: 120ms; }
}

component LevelMeter inherits Rectangle {
    in property <float> level: 0;

    height: 6px;
    border-radius: 3px;
    background: #e4e8eb;
    clip: true;

    Rectangle {
        width: root.level * parent.width;
        height: parent.height;
        border-radius: 3px;
        background: root.level > 0.9 ? #d95858 : (root.level > 0.68 ? #e3a233 : #20a894);
        animate width { duration: 80ms; }
    }
}

component SelectField inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    callback selected(int);
    private property <string> current-label: root.current-index >= 0
        && root.current-index < root.model.length
        ? root.model[root.current-index]
        : "";

    height: 34px;
    border-radius: 4px;
    border-width: 1px;
    border-color: select-touch.has-hover ? #20a894 : #d0d7de;
    background: root.enabled ? #ffffff : #f2f4f5;
    accessible-role: combobox;
    accessible-label: root.current-label;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: false;
    accessible-action-expand => { select-popup.show(); }
    clip: true;

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.current-label == "" ? "请选择" : root.current-label;
            color: root.current-label == "" ? #9aa3ab : #334155;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Path {
            width: 12px;
            height: 12px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 12;
            viewbox-height: 12;
            stroke: #6b7785;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
            opacity: root.enabled ? 1 : 0.45;
            MoveTo { x: 3; y: 4.5; }
            LineTo { x: 6; y: 7.5; }
            LineTo { x: 9; y: 4.5; }
        }
    }

    select-touch := TouchArea {
        enabled: root.enabled;
        clicked => { select-popup.show(); }
    }

    select-popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(6, root.model.length) * 30px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            border-width: 1px;
            border-color: #c8d0d6;
            background: #ffffff;
            clip: true;

            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: root.model.length * 30px + 8px;

                option-list := VerticalBox {
                    width: root.width;
                    height: root.model.length * 30px + 8px;
                    padding: 4px;
                    spacing: 0;

                    for option[index] in root.model : Rectangle {
                        height: 30px;
                        border-radius: 3px;
                        background: index == root.current-index
                            ? #e1f4f0
                            : (option-touch.has-hover ? #f1f4f5 : #ffffff);
                        accessible-role: list-item;
                        accessible-label: option;
                        accessible-action-default => {
                            root.current-index = index;
                            root.selected(index);
                            select-popup.close();
                        }

                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: option;
                            color: #334155;
                            font-size: 10px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        option-touch := TouchArea {
                            clicked => {
                                root.current-index = index;
                                root.selected(index);
                                select-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

component ChevronDown inherits Path {
    width: 12px;
    height: 12px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: #6b7785;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    MoveTo { x: 3; y: 4.5; }
    LineTo { x: 6; y: 7.5; }
    LineTo { x: 9; y: 4.5; }
}

component ChevronRight inherits Path {
    width: 12px;
    height: 12px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: #71808c;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    MoveTo { x: 4.5; y: 3; }
    LineTo { x: 7.5; y: 6; }
    LineTo { x: 4.5; y: 9; }
}

component OptionsIcon inherits Rectangle {
    in property <bool> expanded: false;

    width: 12px;
    height: 30px;
    background: transparent;

    if root.expanded: ChevronDown { x: 0; y: 9px; }
    if !root.expanded: ChevronRight { x: 0; y: 9px; }
}

component SourceGlyph inherits Path {
    width: 20px;
    height: 20px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: #188f7e;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    MoveTo { x: 2; y: 10; }
    LineTo { x: 5; y: 10; }
    LineTo { x: 7; y: 5; }
    LineTo { x: 10; y: 15; }
    LineTo { x: 13; y: 7; }
    LineTo { x: 15; y: 10; }
    LineTo { x: 18; y: 10; }
}

component OutputGlyph inherits Path {
    width: 20px;
    height: 20px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: #52606d;
    stroke-width: 1.7px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    MoveTo { x: 3; y: 8; }
    LineTo { x: 6; y: 8; }
    LineTo { x: 10; y: 4; }
    LineTo { x: 10; y: 16; }
    LineTo { x: 6; y: 12; }
    LineTo { x: 3; y: 12; }
    Close { }
    MoveTo { x: 13; y: 7; }
    QuadraticTo { control-x: 17; control-y: 10; x: 13; y: 13; }
}

component RouteSocket inherits Rectangle {
    in property <bool> active: false;

    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: root.active ? #29b6a2 : #9aa6b2;
    background: #ffffff;

    Rectangle {
        x: 3px;
        y: 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.active ? #29b6a2 : #c2cbd2;
    }
}

component GainSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    callback changed(float);
    private property <float> ratio: (root.value + 24) / 36;

    height: 28px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-label: "路由增益 " + root.value + " dB";
    accessible-enabled: root.enabled;

    function set-from-position(position: length) {
        root.value = round(max(0px, min(root.width, position)) / root.width * 36 - 24);
        root.changed(root.value);
    }

    Rectangle {
        y: 12px;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: #dfe5e9;
    }
    Rectangle {
        y: 12px;
        width: max(0px, min(parent.width, root.ratio * parent.width));
        height: 4px;
        border-radius: 2px;
        background: #29b6a2;
    }
    Rectangle {
        x: max(0px, min(parent.width - 14px, root.ratio * (parent.width - 14px)));
        y: 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 2px;
        border-color: #29b6a2;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000026;
    }
    gain-touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.set-from-position(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-from-position(self.mouse-x);
            }
        }
    }
}

component LoopbackToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> label: "开关";
    callback toggled(bool);

    width: 46px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? #29b6a2 : #d5dce2;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Text {
        x: root.checked ? 4px : 24px;
        width: 18px;
        text: root.checked ? "On" : "Off";
        color: root.checked ? #ffffff : #52606d;
        font-size: 8px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: root.checked ? 26px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000026;
        animate x { duration: 120ms; }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    animate background { duration: 120ms; }
}

component EngineBadge inherits Rectangle {
    in property <bool> active: false;
    in property <string> label: "音频引擎已停止";

    width: 252px;
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.active ? #b7e1da : #e2e8f0;
    background: root.active ? #e8f7f4 : #f1f5f9;

    HorizontalBox {
        height: root.height;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.active ? #29b6a2 : #94a3b8;
        }
        Text {
            text: root.label;
            color: root.active ? #1a7e70 : #64748b;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component FooterButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();

    width: 138px;
    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.enabled ? #d0d7de : #e5e7eb;
    background: root.active ? #e8f7f4 : (root.enabled ? #ffffff : #f8fafc);
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Text {
        text: root.label;
        color: root.active ? #1a7e70 : (root.enabled ? #52606d : #94a3b8);
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ColumnHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";

    width: 280px;
    height: 44px;

    VerticalBox {
        x: 0;
        y: 0;
        width: parent.width - 34px;
        height: parent.height - 7px;
        padding: 0;
        spacing: 1px;
        Text {
            text: root.title;
            color: #1e293b;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.subtitle;
            color: #64748b;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        x: parent.width - 26px;
        y: 0;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        border-width: 1px;
        border-color: #e2e8f0;
        background: #ffffff;
        opacity: 0.6;
        Text {
            text: "+";
            color: #64748b;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #d7dde3; }
}

component DeviceItem inherits Rectangle {
    in-out property <bool> route-enabled: true;
    in property <bool> running: false;
    callback toggled(bool);

    height: 84px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #dfe5ea;
    background: #ffffff;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #0000000d;

    VerticalBox {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 9px;
        spacing: 7px;
        HorizontalBox {
            height: 30px;
            spacing: 8px;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: #e5f6f2;
                SourceGlyph { x: 4px; y: 4px; }
            }
            VerticalBox {
                padding: 0;
                spacing: 1px;
                horizontal-stretch: 1;
                Text { text: "主路由"; color: #1e293b; font-size: 12px; font-weight: 700; }
                Text { text: root.running ? "引擎运行中" : "1 个进程 / 1 个输出"; color: #64748b; font-size: 10px; overflow: elide; }
            }
            LoopbackToggle {
                checked <=> root.route-enabled;
                enabled: true;
                label: "侧栏路由开关";
                toggled(value) => { root.toggled(value); }
            }
        }
        LevelMeter { level: root.route-enabled ? (root.running ? 0.38 : 0) : 0; height: 7px; }
    }
}

component SourceChannelRow inherits HorizontalBox {
    in property <string> label: "";
    in property <float> level: 0;

    height: 20px;
    spacing: 8px;
    Text {
        width: 38px;
        height: 20px;
        text: root.label;
        color: #1e293b;
        font-size: 10px;
        font-weight: 600;
        vertical-alignment: center;
    }
    LevelMeter { level: root.level; height: 9px; horizontal-stretch: 1; }
}

component MonitorChannelRow inherits HorizontalBox {
    in property <string> label: "";
    in property <float> level: 0;

    height: 20px;
    spacing: 8px;
    LevelMeter { level: root.level; height: 9px; horizontal-stretch: 1; }
    Text {
        width: 86px;
        height: 20px;
        text: root.label;
        color: #1e293b;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component SourceNode inherits Rectangle {
    in property <[string]> source-model: [];
    in-out property <int> source-index: -1;
    in property <float> meter: 0;
    in-out property <float> gain: 0;
    in-out property <bool> expanded: false;
    in-out property <bool> route-enabled: true;
    callback source-selected(int);
    callback toggle-route(bool);
    callback apply-gain(float);
    private property <bool> has-source: root.source-index >= 0
        && root.source-index < root.source-model.length;

    width: 280px;
    height: root.expanded ? 292px : 222px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #e2e8f0;
    background: #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000014;
    opacity: root.route-enabled ? 1 : 0.82;
    animate height { duration: 140ms; }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 57px;
        border-radius: 8px;
        background: #fafbfc;
        HorizontalBox {
            width: root.width;
            height: 57px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: #e8f7f4;
                SourceGlyph { x: 6px; y: 6px; }
            }
            VerticalBox {
                padding: 0;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.has-source ? root.source-model[root.source-index] : "选择音频来源";
                    color: #1e293b;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text { text: "进程回环音频"; color: #64748b; font-size: 10px; }
            }
            LoopbackToggle {
                checked <=> root.route-enabled;
                enabled: root.has-source;
                label: "声源开关";
                toggled(value) => { root.toggle-route(value); }
            }
        }
        Rectangle { y: 56px; width: root.width; height: 1px; background: #e2e8f0; }
    }

    VerticalBox {
        x: 14px;
        y: 67px;
        width: root.width - 28px;
        height: root.height - 78px;
        padding: 0;
        spacing: 6px;
        SelectField {
            model: root.source-model;
            current-index <=> root.source-index;
            enabled: root.source-model.length > 0;
            height: 30px;
            selected(index) => { root.source-selected(index); }
        }
        VerticalBox {
            height: 48px;
            padding: 0;
            spacing: 4px;
            SourceChannelRow { label: "1 (L)"; level: root.route-enabled ? root.meter : 0; }
            SourceChannelRow { label: "2 (R)"; level: root.route-enabled ? root.meter : 0; }
        }
        Rectangle {
            height: 30px;
            background: options-touch.has-hover ? #f1f8f6 : transparent;
            accessible-role: button;
            accessible-label: root.expanded ? "收起高级选项" : "展开高级选项";
            accessible-action-default => { root.expanded = !root.expanded; }
            OptionsIcon { x: 2px; y: 0px; expanded: root.expanded; }
            Text { x: 20px; y: 6px; width: parent.width - 68px; height: 18px; text: "高级选项 (Options)"; color: #596773; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            Text { x: parent.width - 48px; y: 6px; width: 46px; height: 18px; text: round(root.gain) + " dB"; color: #7a8792; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
            options-touch := TouchArea { clicked => { root.expanded = !root.expanded; } }
        }
        if root.expanded: Rectangle {
            height: 88px;
            border-radius: 5px;
            border-width: 1px;
            border-color: #e2e8f0;
            background: #f8fafc;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                HorizontalBox {
                    height: 28px;
                    Text { text: "增益 (Gain)"; color: #64748b; font-size: 10px; vertical-alignment: center; }
                    GainSlider { horizontal-stretch: 1; value <=> root.gain; enabled: root.route-enabled; changed(value) => { root.apply-gain(value); } }
                }
                HorizontalBox {
                    height: 28px;
                    Text { height: 28px; text: "静音 (Mute)"; color: #64748b; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                    MuteButton {
                        muted: !root.route-enabled;
                        clicked => { root.toggle-route(!root.route-enabled); }
                    }
                }
            }
        }
    }
    RouteSocket { x: root.width - 7px; y: 143px; active: root.route-enabled && root.has-source; }
}

component MixChannelRow inherits HorizontalBox {
    in property <string> label: "";
    in property <float> level: 0;
    height: 20px;
    spacing: 8px;
    Text { width: 86px; height: 20px; text: root.label; color: #1e293b; font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
    LevelMeter { level: root.level; height: 9px; horizontal-stretch: 1; }
}

component MixNode inherits Rectangle {
    in property <float> meter: 0;
    in property <bool> route-enabled: true;
    in property <bool> show-output: true;

    width: 280px;
    height: 222px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #e2e8f0;
    background: #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000014;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 57px;
        border-radius: 8px;
        background: #fafbfc;
        VerticalBox {
            x: 14px;
            y: 10px;
            width: root.width - 28px;
            height: 36px;
            padding: 0;
            spacing: 1px;
            Text { text: "Channels 1 & 2"; color: #1e293b; font-size: 13px; font-weight: 700; vertical-alignment: center; }
            Text { text: "立体声通道组"; color: #64748b; font-size: 10px; vertical-alignment: center; }
        }
        Rectangle { y: 56px; width: root.width; height: 1px; background: #e2e8f0; }
    }
    VerticalBox {
        x: 14px;
        y: 67px;
        width: root.width - 28px;
        height: root.height - 78px;
        padding: 0;
        spacing: 8px;
        Text { text: "默认立体声映射"; color: #64748b; font-size: 10px; font-weight: 600; }
        MixChannelRow { label: "Channel 1 (L)"; level: root.route-enabled ? root.meter : 0; }
        MixChannelRow { label: "Channel 2 (R)"; level: root.route-enabled ? root.meter : 0; }
    }
    RouteSocket { x: -7px; y: 143px; active: root.route-enabled; }
    RouteSocket { x: root.width - 7px; y: 143px; active: root.route-enabled && root.show-output; }
}

component OutputNode inherits Rectangle {
    in property <[string]> output-model: [];
    in-out property <int> output-index: -1;
    in property <float> meter: 0;
    in-out property <bool> route-enabled: true;
    in property <bool> running: false;
    callback output-selected(int);
    callback toggle-route(bool);
    private property <bool> has-output: root.output-index >= 0
        && root.output-index < root.output-model.length;

    width: 280px;
    height: 222px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #e2e8f0;
    background: #ffffff;
    drop-shadow-blur: 7px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000014;
    opacity: root.route-enabled ? 1 : 0.82;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 57px;
        border-radius: 8px;
        background: #fafbfc;
        HorizontalBox {
            width: root.width;
            height: 57px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: #f1f5f9;
                OutputGlyph { x: 6px; y: 6px; }
            }
            VerticalBox {
                padding: 0;
                spacing: 1px;
                horizontal-stretch: 1;
                Text { text: root.has-output ? root.output-model[root.output-index] : "选择监听设备"; color: #1e293b; font-size: 12px; font-weight: 700; overflow: elide; }
                Text { text: "默认音频输出设备"; color: #64748b; font-size: 10px; }
            }
            LoopbackToggle {
                checked <=> root.route-enabled;
                enabled: root.has-output;
                label: "监听开关";
                toggled(value) => { root.toggle-route(value); }
            }
        }
        Rectangle { y: 56px; width: root.width; height: 1px; background: #e2e8f0; }
    }
    VerticalBox {
        x: 14px;
        y: 67px;
        width: root.width - 28px;
        height: root.height - 78px;
        padding: 0;
        spacing: 6px;
        SelectField {
            model: root.output-model;
            current-index <=> root.output-index;
            enabled: root.output-model.length > 0;
            height: 30px;
            selected(index) => { root.output-selected(index); }
        }
        VerticalBox {
            height: 48px;
            padding: 0;
            spacing: 4px;
            MonitorChannelRow { label: "Channel 1 (L)"; level: root.route-enabled ? root.meter : 0; }
            MonitorChannelRow { label: "Channel 2 (R)"; level: root.route-enabled ? root.meter : 0; }
        }
        Rectangle { vertical-stretch: 1; }
    }
    RouteSocket { x: -7px; y: 143px; active: root.route-enabled && root.has-output; }
}

component TopologyRoute inherits Rectangle {
    in property <[string]> source-model: [];
    in property <[string]> output-model: [];
    in-out property <int> source-index: -1;
    in-out property <int> output-index: -1;
    in-out property <float> gain: 0;
    in-out property <bool> expanded: false;
    in-out property <bool> route-enabled: true;
    in property <bool> running: false;
    in property <float> source-meter: 0;
    in property <float> output-meter: 0;
    in property <bool> show-output: true;
    callback source-selected(int);
    callback output-selected(int);
    callback toggle-route(bool);
    callback apply-gain(float);
    private property <bool> connected: root.route-enabled
        && root.source-index >= 0
        && root.output-index >= 0;

    width: 980px;
    height: root.expanded ? 278px : 222px;
    background: transparent;
    animate height { duration: 140ms; }

    Path {
        x: 0;
        y: 0;
        width: parent.width;
        height: 278px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 980;
        viewbox-height: 278;
        stroke: root.connected ? #29b6a2 : #97a5b1;
        stroke-width: root.connected ? 4.5px : 3px;
        stroke-line-cap: round;
        fill: transparent;
        opacity: root.connected ? 1 : 0.7;
        MoveTo { x: 280; y: 150; }
        CubicTo { control-1-x: 310; control-1-y: 150; control-2-x: 320; control-2-y: 150; x: 350; y: 150; }
    }
    if root.show-output: Path {
        x: 0;
        y: 0;
        width: parent.width;
        height: 278px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 980;
        viewbox-height: 278;
        stroke: root.connected ? #29b6a2 : #97a5b1;
        stroke-width: root.connected ? 4.5px : 3px;
        stroke-line-cap: round;
        fill: transparent;
        opacity: root.connected ? 1 : 0.7;
        MoveTo { x: 630; y: 150; }
        CubicTo { control-1-x: 660; control-1-y: 150; control-2-x: 670; control-2-y: 150; x: 700; y: 150; }
    }

    SourceNode {
        x: 0;
        y: 0;
        source-model: root.source-model;
        source-index <=> root.source-index;
        meter: root.source-meter;
        gain <=> root.gain;
        expanded <=> root.expanded;
        route-enabled <=> root.route-enabled;
        source-selected(index) => { root.source-selected(index); }
        toggle-route(value) => { root.toggle-route(value); }
        apply-gain(value) => { root.apply-gain(value); }
    }
    MixNode {
        x: 350px;
        y: 0;
        meter: root.source-meter;
        route-enabled: root.connected;
        show-output: root.show-output;
    }
    if root.show-output: OutputNode {
        x: 700px;
        y: 0;
        output-model: root.output-model;
        output-index <=> root.output-index;
        meter: root.output-meter;
        route-enabled: root.route-enabled;
        running: root.running;
        output-selected(index) => { root.output-selected(index); }
        toggle-route(value) => { root.toggle-route(value); }
    }
}

component DemoSourceCard inherits Rectangle {
    in property <string> title: "音频来源";
    in property <string> subtitle: "进程回环音频";
    in property <[string]> source-model: [];
    in-out property <int> source-index: -1;
    in property <float> meter: 0;
    in-out property <float> gain: 0;
    in-out property <bool> expanded: false;
    in-out property <bool> route-enabled: true;
    in property <bool> show-selector: false;
    callback source-selected(int);
    callback toggle-route(bool);
    callback apply-gain(float);

    private property <bool> has-source: root.source-index >= 0
        && root.source-index < root.source-model.length;
    private property <string> display-title: root.show-selector && root.has-source
        ? root.source-model[root.source-index]
        : root.title;

    width: 280px;
    height: root.expanded ? (root.show-selector ? 288px : 260px)
        : (root.show-selector ? 190px : 178px);
    border-radius: 7px;
    border-width: 1px;
    border-color: #e2e8f0;
    background: #ffffff;
    opacity: root.route-enabled ? 1 : 0.82;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000016;
    clip: false;
    animate height { duration: 140ms; }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 52px;
        border-radius: 7px;
        background: #fafbfc;
        HorizontalBox {
            x: 14px;
            y: 0;
            width: root.width - 28px;
            height: 52px;
            spacing: 9px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: #e8f7f4;
                SourceGlyph { x: 6px; y: 6px; }
            }
            VerticalBox {
                padding: 0;
                spacing: 0;
                horizontal-stretch: 1;
                Text {
                    height: 18px;
                    text: root.display-title;
                    color: #1e293b;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    height: 16px;
                    text: root.subtitle;
                    color: #64748b;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            LoopbackToggle {
                checked <=> root.route-enabled;
                enabled: root.has-source || !root.show-selector;
                label: "声源开关";
                toggled(value) => { root.toggle-route(value); }
            }
        }
        Rectangle { y: 51px; width: root.width; height: 1px; background: #e2e8f0; }
    }

    if root.show-selector: SelectField {
        x: 14px;
        y: 61px;
        width: root.width - 28px;
        model: root.source-model;
        current-index <=> root.source-index;
        enabled: root.source-model.length > 0;
        height: 30px;
        selected(index) => { root.source-selected(index); }
    }

    VerticalBox {
        x: 14px;
        y: root.show-selector ? 101px : 63px;
        width: root.width - 28px;
        height: 48px;
        padding: 0;
        spacing: 8px;
        SourceChannelRow { label: "1 (L)"; level: root.route-enabled ? root.meter : 0; }
        SourceChannelRow { label: "2 (R)"; level: root.route-enabled ? root.meter : 0; }
    }

    Rectangle {
        x: 14px;
        y: root.show-selector ? 154px : 116px;
        width: root.width - 28px;
        height: 30px;
        background: options-touch.has-hover ? #f2f8f6 : transparent;
        OptionsIcon { x: 1px; y: 0px; expanded: root.expanded; }
        Text { x: 19px; y: 6px; width: parent.width - 67px; height: 18px; text: "高级选项 (Options)"; color: #64748b; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width - 47px; y: 6px; width: 46px; height: 18px; text: round(root.gain) + " dB"; color: #7a8792; horizontal-alignment: right; vertical-alignment: center; }
        options-touch := TouchArea { clicked => { root.expanded = !root.expanded; } }
    }

    if root.expanded: Rectangle {
        x: 14px;
        y: root.show-selector ? 188px : 150px;
        width: root.width - 28px;
        height: 90px;
        border-radius: 5px;
        border-width: 1px;
        border-color: #e2e8f0;
        background: #f8fafc;
        VerticalBox {
            padding: 8px;
            spacing: 6px;
            HorizontalBox {
                height: 28px;
                Text { height: 28px; text: "增益 (Gain)"; color: #64748b; font-size: 10px; vertical-alignment: center; }
                GainSlider { horizontal-stretch: 1; value <=> root.gain; enabled: root.route-enabled; changed(value) => { root.apply-gain(value); } }
            }
            HorizontalBox {
                height: 28px;
                Text { height: 28px; text: "静音 (Mute)"; color: #64748b; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; }
                MuteButton {
                    muted: !root.route-enabled;
                    clicked => { root.toggle-route(!root.route-enabled); }
                }
            }
        }
    }

    RouteSocket {
        x: root.width - 7px;
        y: root.show-selector ? 123px : 85px;
        active: root.route-enabled && root.has-source;
    }
}

